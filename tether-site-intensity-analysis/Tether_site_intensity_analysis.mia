te" VALUE="0" VISIBLE="false"/><PARAMETER NAME="Width" NICKNAME="Width" VALUE="512" VISIBLE="false"/><PARAMETER NAME="Height" NICKNAME="Height" VALUE="512" VISIBLE="false"/><PARAMETER NAME="Objects for limits" NICKNAME="Objects for limits" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Scale mode" NICKNAME="Scale mode" SHOW_TEXT="false" VALUE="No scaling" VISIBLE="false"/><PARAMETER NAME="X scale factor" NICKNAME="X scale factor" VALUE="0.5" VISIBLE="true"/><PARAMETER NAME="Y scale factor" NICKNAME="Y scale factor" VALUE="1.0" VISIBLE="true"/><PARAMETER NAME="Dimension mismatch mode" NICKNAME="Dimension mismatch mode" SHOW_TEXT="false" VALUE="Disallow (fail upon mismatch)" VISIBLE="false"/><PARAMETER NAME="Pad intensity mode" NICKNAME="Pad intensity mode" SHOW_TEXT="false" VALUE="Black (0)" VISIBLE="false"/><PARAMETER NAME="Set manual spatial calibration" NICKNAME="Set manual spatial calibration" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAMETER NAME="XY calibration (dist/px)" NICKNAME="XY calibration (dist/px)" VALUE="1.0" VISIBLE="false"/><PARAMETER NAME="Z calibration (dist/px)" NICKNAME="Z calibration (dist/px)" VALUE="1.0" VISIBLE="false"/><PARAMETER NAME="Set manual temporal calibration" NICKNAME="Set manual temporal calibration" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAMETER NAME="Frame interval (time/frame)" NICKNAME="Frame interval (time/frame)" VALUE="1.0" VISIBLE="false"/><PARAMETER NAME="Force bit depth" NICKNAME="Force bit depth" SHOW_TEXT="false" VALUE="false" VISIBLE="false"/><PARAMETER NAME="Output bit depth" NICKNAME="Output bit depth" SHOW_TEXT="false" VALUE="8" VISIBLE="false"/><PARAMETER NAME="Minimum input intensity" NICKNAME="Minimum input intensity" VALUE="0.0" VISIBLE="false"/><PARAMETER NAME="Maximum input intensity" NICKNAME="Maximum input intensity" VALUE="1.0" VISIBLE="false"/></PARAMETERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA/></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.script.RunScript" DISABLEABLE="false" ENABLED="true" ID="1795242023" NAME="Run script" NICKNAME="Scale image" NOTES="" SHOW_BASIC_TITLE="false" SHOW_OUTPUT="false" VERSION="1.0.2"><PARAMETERS><PARAMETER NAME="Script mode" NICKNAME="Script mode" SHOW_TEXT="false" VALUE="Script text" VISIBLE="false"/><PARAMETER NAME="Script language" NICKNAME="Script language" SHOW_TEXT="false" VALUE="Groovy" VISIBLE="false"/><PARAMETER NAME="Script text" NICKNAME="Script text" VALUE="// The following two parameters will provide references to the workspace and current module.&#10;#@ io.github.mianalysis.mia.object.Workspace workspace&#10;#@ io.github.mianalysis.mia.module.Module thisModule&#10;&#10;import ij.plugin.Scaler&#10;import io.github.mianalysis.mia.MIA&#10;&#10;im = workspace.getImage(&quot;Im&quot;)&#10;ipl = im.getImagePlus()&#10;&#10;pixelWidth = ipl.getCalibration().pixelWidth&#10;pixelHeight = ipl.getCalibration().pixelHeight&#10;&#10;widthOut = (int) Math.round(ipl.getWidth()*pixelWidth/targetSize)&#10;heightOut = (int) Math.round(ipl.getHeight()*pixelHeight/targetSize)&#10;&#10;iplScaled = Scaler.resize(ipl, widthOut, heightOut, 1, &quot;None&quot;)&#10;im.setImagePlus(iplScaled)&#10;&#10;iplScaled.getCalibration().pixelWidth = targetSize&#10;iplScaled.getCalibration().pixelHeight = targetSize" VISIBLE="false"/><PARAMETER NAME="Script file" NICKNAME="Script file" SHOW_TEXT="false" VALUE="" VISIBLE="false"/><PARAMETER NAME="Add parameter" NICKNAME="Add parameter" VALUE="" VISIBLE="false"><COLLECTION><PARAMS><PARAM NAME="Parameter type" NICKNAME="Parameter type" SHOW_TEXT="false" VALUE="Number" VISIBLE="false"/><PARAM NAME="Parameter name" NICKNAME="Parameter name" VALUE="targetSize" VISIBLE="false"/><PARAM NAME="Parameter checkbox" NICKNAME="Parameter checkbox" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAM NAME="Parameter numeric value" NICKNAME="Target resolution (µm/px)" VALUE="0.1" VISIBLE="true"/><PARAM NAME="Parameter text value" NICKNAME="Target pixel size (um)" VALUE="0.1" VISIBLE="true"/></PARAMS></COLLECTION></PARAMETER><PARAMETER NAME="Add output" NICKNAME="Add output" VALUE="" VISIBLE="false"><COLLECTION/></PARAMETER></PARAMETERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA/></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.system.GUISeparator" DISABLEABLE="false" ENABLED="true" ID="1457359800" NAME="GUI separator" NICKNAME="Tether detection" NOTES="" SHOW_BASIC_TITLE="true" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Show in processing view" NICKNAME="Show in processing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAMETER NAME="Expanded in processing view" NICKNAME="Expanded in processing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/><PARAMETER NAME="Expanded in editing view" NICKNAME="Expanded in editing view" SHOW_TEXT="false" VALUE="true" VISIBLE="false"/></PARAMETERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA/></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.system.DisplayMessage" DISABLEABLE="false" ENABLED="true" ID="1262214833" NAME="Display message" NICKNAME="Display message" NOTES="" SHOW_BASIC_TITLE="false" SHOW_OUTPUT="false" VERSION="1.0.0"><PARAMETERS><PARAMETER NAME="Message text" NICKNAME="Message text" VALUE="&lt;center&gt;&lt;i&gt;Tethers selected in previous runs can be loaded in. If not, ensure &quot;Select tether&quot; is enabled to display tether selection tool&lt;/i&gt;&lt;/center&gt;" VISIBLE="false"/><PARAMETER NAME="Message colour" NICKNAME="Message colour" SHOW_TEXT="false" VALUE="Blue (message)" VISIBLE="false"/><PARAMETER NAME="Message preview" NICKNAME="Message preview" VALUE="&lt;center&gt;&lt;i&gt;Tethers selected in previous runs can be loaded in. If not, ensure &quot;Select tether&quot; is enabled to display tether selection tool&lt;/i&gt;&lt;/center&gt;" VISIBLE="true"/></PARAMETERS><IMAGE_MEASUREMENTS/><OBJECT_MEASUREMENTS/><METADATA/></MODULE><MODULE CLASSNAME="io.github.mianalysis.mia.module.inp